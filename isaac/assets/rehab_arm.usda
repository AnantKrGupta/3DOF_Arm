#usda 1.0
(
    defaultPrim = "rehab_arm"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "rehab_arm" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    customData = {
        string generated_from = "config/arm_params.json"
    }
)
{
    def Xform "base_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.001, 0.001, 0.001)
        rel physics:filteredPairs = [
            </rehab_arm/shoulder_link>,
            </rehab_arm/upper_arm>,
            </rehab_arm/forearm>,
        ]
        float physics:mass = 1
        quatf physics:principalAxes = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "housing"
        {
            float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
            color3f[] primvars:displayColor = [(0.4, 0.4, 0.45)]
            double size = 1
            float3 xformOp:scale = (0.08, 0.12, 0.08)
            double3 xformOp:translate = (-0.06, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "shoulder_link" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.00002, 0.00002, 0.00002)
        rel physics:filteredPairs = [
            </rehab_arm/base_link>,
            </rehab_arm/upper_arm>,
            </rehab_arm/forearm>,
        ]
        float physics:mass = 0.05
        quatf physics:principalAxes = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Sphere "joint_ball"
        {
            float3[] extent = [(-0.045, -0.045, -0.045), (0.045, 0.045, 0.045)]
            color3f[] primvars:displayColor = [(0.15, 0.15, 0.15)]
            double radius = 0.045
        }
    }

    def Xform "upper_arm" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, -0.135)
        float3 physics:diagonalInertia = (0.01249, 0.01249, 0.00098)
        rel physics:filteredPairs = [
            </rehab_arm/base_link>,
            </rehab_arm/shoulder_link>,
            </rehab_arm/forearm>,
        ]
        float physics:mass = 1.6
        quatf physics:principalAxes = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cylinder "link" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            float3[] extent = [(-0.035, -0.035, -0.15), (0.035, 0.035, 0.15)]
            double height = 0.3
            color3f[] primvars:displayColor = [(0.2, 0.45, 0.85)]
            double radius = 0.035
            double3 xformOp:translate = (0, 0, -0.15)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "forearm" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsFilteredPairsAPI"]
    )
    {
        point3f physics:centerOfMass = (0, 0, -0.2104375)
        float3 physics:diagonalInertia = (0.02564226, 0.02564226, 0.000495)
        rel physics:filteredPairs = [
            </rehab_arm/base_link>,
            </rehab_arm/shoulder_link>,
            </rehab_arm/upper_arm>,
        ]
        float physics:mass = 1.6
        quatf physics:principalAxes = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, -0.3)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cylinder "link" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            uniform token axis = "Z"
            float3[] extent = [(-0.03, -0.03, -0.175), (0.03, 0.03, 0.175)]
            double height = 0.35
            color3f[] primvars:displayColor = [(0.25, 0.65, 0.9)]
            double radius = 0.03
            double3 xformOp:translate = (0, 0, -0.175)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Sphere "elbow_ball"
        {
            float3[] extent = [(-0.04, -0.04, -0.04), (0.04, 0.04, 0.04)]
            color3f[] primvars:displayColor = [(0.15, 0.15, 0.15)]
            double radius = 0.04
        }

        def Sphere "hand" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            float3[] extent = [(-0.04, -0.04, -0.04), (0.04, 0.04, 0.04)]
            color3f[] primvars:displayColor = [(0.9, 0.75, 0.6)]
            double radius = 0.04
            double3 xformOp:translate = (0, 0, -0.35)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "ee_frame"
        {
            double3 xformOp:translate = (0, 0, -0.35)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def PhysicsFixedJoint "root_joint"
    {
        rel physics:body1 = </rehab_arm/base_link>
    }

    def Scope "joints"
    {
        def PhysicsRevoluteJoint "shoulder_abduction" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.5235988
            float drive:angular:physics:maxForce = 25
            float drive:angular:physics:stiffness = 6.981317
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "X"
            rel physics:body0 = </rehab_arm/base_link>
            rel physics:body1 = </rehab_arm/shoulder_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -20
            float physics:upperLimit = 150
        }

        def PhysicsRevoluteJoint "shoulder_flexion" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.5235988
            float drive:angular:physics:maxForce = 25
            float drive:angular:physics:stiffness = 6.981317
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </rehab_arm/shoulder_link>
            rel physics:body1 = </rehab_arm/upper_arm>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 0, 0, 1)
            quatf physics:localRot1 = (0, 0, 0, 1)
            float physics:lowerLimit = -45
            float physics:upperLimit = 160
        }

        def PhysicsRevoluteJoint "elbow_flexion" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.5235988
            float drive:angular:physics:maxForce = 12
            float drive:angular:physics:stiffness = 6.981317
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            rel physics:body0 = </rehab_arm/upper_arm>
            rel physics:body1 = </rehab_arm/forearm>
            point3f physics:localPos0 = (0, 0, -0.3)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, 0, 0, 1)
            quatf physics:localRot1 = (0, 0, 0, 1)
            float physics:lowerLimit = 0
            float physics:upperLimit = 145
        }
    }
}

